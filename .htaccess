# NEWGEN BIOSCIENCE — single-page app
# All routes (/products/ruminant, /products/poultry/flavinta, ...) are handled
# by the JS router in index.html, so any URL that is not a real file on disk
# must be served index.html instead of an Apache 404.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Never rewrite requests for files or directories that actually exist
    # (this is what lets /assets/*.webp be served normally).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Permanent redirects for product URLs that were renamed (Nov 2026).
    RewriteRule ^products/aquaculture/inocel/?$        /products/aquaculture/innocell [R=301,L]
    RewriteRule ^products/poultry/ultra-zyme/?$        /products/poultry/ultrazyme    [R=301,L]
    RewriteRule ^products/poultry/flora-zyme/?$        /products/poultry/florazyme    [R=301,L]
    RewriteRule ^products/aquaculture/sporogen-aqua/?$ /products/aquaculture/sporogen [R=301,L]
    RewriteRule ^products/aquaculture/spark-2x-aqua/?$ /products/aquaculture/spark-2x [R=301,L]
    RewriteRule ^products/aquaculture/opti-ph-aqua/?$  /products/aquaculture/opti-ph  [R=301,L]
    RewriteRule ^shop/product/sporogen-poultry/?$      /shop/product/sporogen         [R=301,L]
    RewriteRule ^shop/product/milkma-shop/?$           /shop/product/milkma           [R=301,L]
    RewriteRule ^shop/product/breed-ezy-shop/?$        /shop/product/breed-ezy        [R=301,L]

    RewriteRule ^ index.html [L]
</IfModule>

# Correct MIME type for .webp on older server configs
<IfModule mod_mime.c>
    AddType image/webp .webp
</IfModule>

# Cache images, but keep index.html always fresh so router changes go live
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png  "access plus 1 month"
    ExpiresByType text/html  "access plus 0 seconds"
</IfModule>
